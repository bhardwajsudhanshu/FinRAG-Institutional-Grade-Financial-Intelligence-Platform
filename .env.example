# =============================================================================
# FinRAG — Environment Configuration
# Copy this file to `.env` and fill in real values. `.env` is gitignored.
# =============================================================================

# --- GCP / Vertex AI --------------------------------------------------------
# Set these when ready to wire real GCP. Until then, leave blank and use the
# mock embedder/generator (EMBEDDER_BACKEND=mock, GENERATOR_BACKEND=mock).
GCP_PROJECT_ID=
GCP_REGION=us-central1
# Service account JSON key path (alternative to gcloud auth login).
# GOOGLE_APPLICATION_CREDENTIALS=F:/projects/FinRAG.../secrets/sa-key.json

# --- Embedder / Generator backends ------------------------------------------
# Options: mock | vertex
# Use `mock` for offline development; `vertex` for production runs.
EMBEDDER_BACKEND=mock
GENERATOR_BACKEND=mock

# Vertex model IDs (used when EMBEDDER_BACKEND=vertex or GENERATOR_BACKEND=vertex)
VERTEX_EMBEDDING_MODEL=text-embedding-005
VERTEX_GENERATOR_MODEL=gemini-2.5-flash
VERTEX_EVAL_GENERATOR_MODEL=gemini-2.5-pro

# --- Chunking (exp_001 baseline) -------------------------------------------
CHUNK_SIZE_TOKENS=512
CHUNK_OVERLAP_TOKENS=50

# --- Vector DB (STEP_018, hardened STEP_037) ---------------------------------
# Options: in-memory | qdrant ("chroma" was never implemented — do not use)
VECTORDB_BACKEND=in-memory
# Live Qdrant (needs `make docker-up` when VECTORDB_BACKEND=qdrant)
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=finrag_eval
# true: rebuild every run (deterministic evals). false: attach to a
# pre-warmed collection (serving — pre-warm once, see below). Default true.
QDRANT_RECREATE=true
CHROMA_PERSIST_DIR=./data/chroma

# --- Retrieval --------------------------------------------------------------
RETRIEVAL_TOP_K=5
EMBEDDING_DIM=768
# Rerank: none | flash-pointwise | cross-encoder (default none = frozen behavior)
RERANK_BACKEND=none
RERANK_CANDIDATES=10
# Multi-query expansion: true | false (default false = frozen behavior)
MULTIQUERY_ENABLED=false
MULTIQUERY_PARAPHRASES=3

# --- Logging / cost tracking ------------------------------------------------
COST_LOG_PATH=./data/runtime_costs.jsonl
LOG_LEVEL=INFO
